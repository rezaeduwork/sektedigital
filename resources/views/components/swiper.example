<div class="swiper">
  <div class="swiper-wrapper">

  </div>
</div>
<script>
  const swiper = new Swiper('.swiper', {
  // Optional parameters
  loop: true,
  grabCursor: true,
  centeredSlides: false,
  spaceBetween: 16,

  breakpoints: {
    640: {
      slidesPerView: 2,
    },
    768: {
      slidesPerView: 4,
    },
    1024: {
      slidesPerView: 5,
    },
  },

  // If we need pagination
  pagination: {
    el: '.swiper-pagination',
    clickable: true,
  },

  // Navigation arrows
  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },

  // And if we need scrollbar
  scrollbar: {
    el: '.swiper-scrollbar',
  },
});
</script>
